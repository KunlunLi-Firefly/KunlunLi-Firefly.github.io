---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
	title,
	summary,
	year,
	status,
	researchArea,
	methods,
	datasets,
	results,
	role,
	collaborators,
	cover,
	links,
} = project.data;
const linkItems = [
	{ label: "Code", url: links.repository, icon: "fa7-brands:github" },
	{
		label: "Paper",
		url: links.paper,
		icon: "material-symbols:article-outline",
	},
	{
		label: "Demo",
		url: links.demo,
		icon: "material-symbols:play-circle-outline",
	},
	{
		label: "Report",
		url: links.report,
		icon: "material-symbols:picture-as-pdf-outline",
	},
].filter((item) => item.url);
---

<MainGridLayout title={title} description={summary}>
	<article>
		<header class="card-base overflow-hidden rounded-(--radius-large)">
			{cover && <img src={cover} alt={`Preview of ${title}`} class="max-h-[34rem] w-full bg-black object-contain" />}
			<div class="p-6 md:p-9">
				<div class="flex flex-wrap gap-2 text-xs font-medium text-50">
					<span class="rounded-full bg-(--primary)/10 px-2.5 py-1 text-(--primary)">{researchArea}</span>
					<span class="px-1 py-1">{year}</span>
					<span class="px-1 py-1 capitalize">{status}</span>
				</div>
				<h1 class="mt-4 text-3xl font-bold leading-tight text-90 md:text-5xl">{title}</h1>
				<p class="mt-5 max-w-4xl text-lg leading-8 text-70">{summary}</p>
				{linkItems.length > 0 && (
					<div class="mt-6 flex flex-wrap gap-3">
						{linkItems.map((item) => (
							<a href={item.url} target={item.url?.startsWith("http") ? "_blank" : undefined} rel="noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-(--primary) px-4 py-2.5 font-semibold text-white">
								<Icon name={item.icon} class="text-lg" /> {item.label}
							</a>
						))}
					</div>
				)}
			</div>
		</header>

		<section class="mt-4 grid gap-4 md:grid-cols-2">
			<div class="card-base rounded-(--radius-large) p-6">
				<h2 class="text-xl font-bold text-90">Methods and data</h2>
				<div class="mt-4 flex flex-wrap gap-2">{methods.map((method) => <span class="rounded-md bg-black/5 px-2.5 py-1 text-sm text-70 dark:bg-white/5">{method}</span>)}</div>
				{datasets.length > 0 && <p class="mt-4 text-sm leading-6 text-60"><strong>Datasets:</strong> {datasets.join(", ")}</p>}
			</div>
			<div class="card-base rounded-(--radius-large) p-6">
				<h2 class="text-xl font-bold text-90">Contribution and evidence</h2>
				{role && <p class="mt-4 leading-7 text-70"><strong>Role:</strong> {role}</p>}
				{collaborators.length > 0 && <p class="mt-3 text-sm leading-6 text-60"><strong>Collaborators:</strong> {collaborators.join(", ")}</p>}
				{results.length > 0 && <ul class="mt-4 list-disc space-y-2 pl-5 text-70">{results.map((result) => <li>{result}</li>)}</ul>}
			</div>
		</section>

		<section class="card-base mt-4 rounded-(--radius-large) p-6 md:p-9">
			<Markdown class="project-content"><Content /></Markdown>
		</section>
	</article>
</MainGridLayout>
